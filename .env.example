# ─────────────────────────────────────────────────────────────
#  Adore Showcase — environment template
#
#  Copy to `.env.local` and fill in. NEVER commit a real .env file;
#  `.env*` is gitignored (see .gitignore).
#
#  No value below is real. Every secret in this file is a placeholder
#  — the sanitized showcase contains no production credentials.
# ─────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────
# Postgres connection string. The showcase targets a serverless
# Postgres (Neon in the original deployment); any reachable Postgres
# works, since Drizzle speaks the same dialect.
#   Neon:  postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
#   Local: postgresql://postgres:postgres@localhost:5432/adore_showcase
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Sessions / JWT ─────────────────────────────────────────
# Signs the ACCESS token (1 hour). Must be >= 32 characters —
# anything shorter is rejected at boot rather than at first login.
# Generate with:  openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-random-characters"

# Signs the REFRESH token (1 day).
#
# This must be a SEPARATE random value, not a derivative of
# JWT_SECRET. Separate keys mean a leaked access token cannot be
# replayed as a refresh token to mint a long-lived session.
# Generate with:  openssl rand -base64 48
JWT_REFRESH_SECRET="replace-me-with-a-different-32-char-secret"

# ── Site metadata (optional) ────────────────────────────────
# Used for absolute URLs in metadata / email. Relative paths are
# used elsewhere so a preview deploy needs no configuration.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"